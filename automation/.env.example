# Email (SMTP) — required
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-user@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=Daily Posts <your-user@gmail.com>
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Buffer — required only if you also want to auto-queue to Buffer
BUFFER_ACCESS_TOKEN=your-buffer-personal-access-token
BUFFER_PROFILE_IDS=profile_id_1,profile_id_2
IMAGE_RAW_BASE=https://raw.githubusercontent.com/tarisha-starr/GitHub-folder/main

# GoPlus (app.usegoplus.com) — required only once the GoPlus puller is built.
# Get these from GoPlus: Settings → API / Developers. Add the same names as
# GitHub Actions secrets at:
#   https://github.com/tarisha-starr/GitHub-folder/settings/secrets/actions/new
# Nothing reads these yet. The client can't be written until the API shape is
# known, because usegoplus.com blocks automated doc fetches (403).
GOPLUS_API_KEY=your-goplus-api-key
GOPLUS_API_BASE=https://api.usegoplus.com
GOPLUS_ACCOUNT_ID=your-goplus-account-id

# YouTube — required only for fetch_outliers.py (Level 1 find-outliers skill)
# Create a key at https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
